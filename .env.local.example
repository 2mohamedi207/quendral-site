# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Calendly (calendly.com/integrations/api_webhooks -> Personal Access Tokens)
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/304fc23d-8aa8-4798-84e6-3884c39467fe
CALENDLY_USER_URI=https://api.calendly.com/users/a37cdbc1-72b2-4273-a58e-63d0de8f76e5

# Returned when the Calendly webhook subscription is created (invitee.created event,
# callback_url = https://<your-deployed-domain>/api/webhooks/calendly)
CALENDLY_WEBHOOK_SIGNING_KEY=

# Twilio (twilio.com console -> Account SID + Auth Token, plus a purchased phone number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend (resend.com -> API Keys). Requires verifying your sending domain
# (e.g. quendral.com) in the Resend dashboard before RESEND_FROM_EMAIL will work.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Quendral <hello@quendral.com>

# Where intake form notifications get sent internally (defaults to
# info@luminaeautomations.com if unset)
INTAKE_NOTIFICATION_EMAIL=info@luminaeautomations.com

# Used to build links inside emails (defaults to https://quendral.com if unset)
NEXT_PUBLIC_SITE_URL=https://quendral.com

# Stripe (dashboard.stripe.com -> Developers -> API keys)
# Use a sk_test_... key first and confirm checkout works end-to-end before ever
# switching to a live sk_live_... key. Requires the account's legal/business
# details to be filled out correctly under Settings -> Business details first.
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=cad
